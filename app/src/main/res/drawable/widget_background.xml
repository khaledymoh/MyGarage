<?xml version="1.0" encoding="utf-8"?>
<!-- Cockpit widget surface: dark gradient with a faint Ice-blue edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="300"
        android:endColor="#0B1019"
        android:startColor="#121A28" />
    <stroke
        android:width="1dp"
        android:color="#245AA9FF" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
