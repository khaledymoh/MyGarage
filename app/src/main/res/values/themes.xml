<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MyGarage" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/garage_background</item>
        <item name="android:statusBarColor">@color/garage_background</item>
    </style>

    <style name="Theme.MyGarage.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/garage_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.MyGarage</item>
    </style>
</resources>